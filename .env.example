DATABASE_PATH=".data/postgres"
# Link connects real accounts once authentication and Link OAuth credentials are configured.
# Leave secrets in this example blank. Configure actual values only in .env or a secret manager.
ENCRYPTION_KEY=""
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""
CDP_WALLET_SECRET=""
# Staging only: server API key must start sk_staging_
CROSSMINT_SERVER_API_KEY=""
# Separate 64-hex-character master signer secrets; keep stable for existing wallets.
CROSSMINT_RECOVERY_SIGNER_SECRET=""
CROSSMINT_WALLET_SIGNER_SECRET=""
LINK_CLIENT_ID=""
LINK_CLIENT_SECRET=""
LINK_REDIRECT_URI="http://localhost:3000/api/link/callback"
# GitHub OAuth application callback: http://localhost:3000/api/auth/callback/github
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Stripe publishable key (not your Stripe secret API key)
LINK_PUBLISHABLE_KEY=""
# ENCRYPTION_KEY above must contain exactly 64 random hex characters (32 bytes).
